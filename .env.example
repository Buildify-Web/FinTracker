# Postgres connection string for your managed VPS database.
# sslmode=require is recommended for most managed Postgres providers.
DATABASE_URL=postgres://user:password@your-vps-host:5432/fintracker?sslmode=require

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Seeded on first `npm run seed:admin` run (see README).
ADMIN_EMAIL=you@buildify.example
ADMIN_PASSWORD=change-me

# ---- Invoice emails (Brevo SMTP) ----
# Brevo > SMTP & API > SMTP. The login is the one shown there; the password is an SMTP key you generate (not your account password).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
# Must be a sender you have verified in Brevo (Senders, Domains & Dedicated IPs).
EMAIL_FROM=billing@your-domain.com
# Public address of this app; used for the invoice links inside emails.
APP_URL=https://your-app.example.com
# Protects the daily reminder job. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string
